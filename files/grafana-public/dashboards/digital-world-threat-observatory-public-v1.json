      "options": {
        "mode": "html",
        "content": "\n<div style=\"\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  width:100%;\n  height:100%;\n  box-sizing:border-box;\n  padding:10px 18px;\n  background:linear-gradient(90deg,#020617 0%, #071226 45%, #020617 100%);\n  border:1px solid rgba(34,211,238,.30);\n  border-radius:10px;\n  overflow:hidden;\n\">\n  <div style=\"display:flex;align-items:center;gap:16px;min-width:0;\">\n    <img src=\"/public/img/custom/digital-world-logo.png\" alt=\"Digital World Logo\"\n         style=\"height:58px;width:auto;display:block;border-radius:6px;box-shadow:0 0 14px rgba(34,211,238,.18);\" />\n    <div style=\"min-width:0;\">\n      <div style=\"\n        font-size:30px;\n        line-height:1.08;\n        font-weight:900;\n        color:#f8fafc;\n        white-space:nowrap;\n        overflow:hidden;\n        text-overflow:ellipsis;\n        margin-bottom:6px;\n      \">\n        Digital World Live Threat Observatory\n      </div>\n      <div style=\"\n        font-size:14px;\n        color:#a5b4c3;\n        white-space:nowrap;\n        overflow:hidden;\n        text-overflow:ellipsis;\n      \">\n        Live CrowdSec telemetry · attack trends · scenarios · GeoIP · ASN/provider intelligence\n      </div>\n    </div>\n  </div>\n\n  <div style=\"\n    flex:0 0 auto;\n    text-align:right;\n    font-size:12px;\n    line-height:1.3;\n    color:#22d3ee;\n    font-weight:800;\n    letter-spacing:.04em;\n    margin-left:14px;\n  \">\n    PUBLIC KIOSK<br>REFRESH 30s\n  </div>\n</div>\n"
      },
      "transparent": true
    },
